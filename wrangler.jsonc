{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelf",
  // One Worker serves Next.js, /mcp, the queue consumer and the cron (ADR-001).
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    // D1 `shelf`, created 11 Nov 2026 (WNAM).
    { "binding": "DB", "database_name": "shelf", "database_id": "7973d001-f24c-468b-955d-0ae4bc22758c", "migrations_dir": "db/migrations" }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "shelf-photos" }],
  "queues": {
    "producers": [{ "binding": "EXTRACTION_QUEUE", "queue": "extraction" }],
    "consumers": [{ "queue": "extraction", "max_retries": 3, "dead_letter_queue": "extraction-failed", "max_batch_size": 5, "max_batch_timeout": 1 }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "AIG_NAME": "shelf",
    "GCP_LOCATION": "global",
    "PAYPAL_BASE": "https://api-m.sandbox.paypal.com",
    // The sandbox client ID is public by design (the Pay page sends it to browsers). The secret stays a Worker secret.
    "PAYPAL_CLIENT_ID": "ATCYFnoau1r-G6IRyt_A9I5HFH_eLi9BE06ZgtremrIBjcLMpmcV6FLlmWvAVJ2dqxTZ0KI1NKeU1WW2",
    "PAYPAL_WEBHOOK_ID": "7HR55136S1176423F",
    // One origin, no trailing slash. Local runs override it in .dev.vars.
    "PUBLIC_ORIGIN": "https://shelf.160422733171.workers.dev"
  }
}
